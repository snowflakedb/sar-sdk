{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/connection-options/index.ts",
    "src/connection-manager/index.ts",
    "src/query-client/index.ts",
    "src/fetch-client/index.ts",
